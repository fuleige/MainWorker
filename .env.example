# 留空时会在 .data/access-token 自动生成高强度访问口令。
# WORKBENCH_TOKEN=replace-with-a-long-random-token

# Markdown 文章库根目录。
ARTICLE_ROOT=/Users/fulei/Codes/Basic

# 算法学习文章库根目录。
ALGORITHM_ARTICLE_ROOT=/Users/fulei/Codes/AlgorithmLearn

# 深度学习基础文章库根目录，仅收录 part-* 目录下的 Markdown。
DEEP_LEARNING_BOOK_ROOT=/Users/fulei/Codes/DLProjects/Interview/book

# API 仅供前端开发服务器反向代理，局域网无需修改。
API_HOST=127.0.0.1
API_PORT=4390

# 可选：同时设置以下两项后，生产服务会直接启用 HTTPS。
# 证书文件可以包含完整证书链；私钥和证书应放在项目目录之外。
# TLS_CERT_FILE=/absolute/path/to/fullchain.pem
# TLS_KEY_FILE=/absolute/path/to/private.key
